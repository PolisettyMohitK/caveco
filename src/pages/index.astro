---
import Base from '../layouts/Base.astro';
import { render } from '../data/renders';
import HeroLife from '../components/HeroLife.astro';
import { pic, meta, isPlan } from '../data/media';
import { home } from '../data/home';
import { models as range, steps } from '../data/models';

// All copy and photos below come from src/content/home.json (CMS: Landing page).
const { highlights, features, orion, compare, promises } = home;
const models = range.map((m) => ({ name: m.name, line: m.line || m.blurb, image: m.card, price: m.price ?? 'Price on request', href: `/models/${m.slug}` }));
---
<Base page="home">
  <!-- ============ Hero: CAVE CO. stamped into the render, house in front ============ -->
  <section class="hero">
    <div class="stage" data-hero>
      <img class="h-bg" {...render(4)} alt="A Cave Co. stone farmhouse at golden hour" fetchpriority="high" data-h-bg />
      <span class="stamp" aria-hidden="true" data-stamp>CAVE CO.</span>
      <img class="h-fg" src="/media/2bhk/ext-4-fg.webp" width="1774" height="887" alt="" aria-hidden="true" data-h-fg />
      <HeroLife />
    </div>
    <div class="hero-copy">
      <h1 class="h-display" data-reveal>{home.hero.title}</h1>
      <div class="hero-side" data-reveal data-delay="0.1">
        <p class="lede">{home.hero.text}</p>
        <div class="row">
          <button class="btn" data-enquire>Build a farmhouse</button>
          <a class="btn ghost" href="#resort">Build a resort</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ About ============ -->
  <section class="about wrap" id="about">
    <p class="about-k" data-reveal>About Cave Co.</p>
    <p class="about-t" data-reveal data-delay="0.05">
      We design, make and install farmhouses around Hyderabad and across Telangana. One team takes your home
      from the first sketch to the keys, so owning land finally means owning a place to stay on it.
    </p>
  </section>

  <!-- ============ Highlights ============ -->
  <section class="sec">
    <h2 class="h-section wrap" data-reveal>Highlights.</h2>
    <div class="car" data-carousel>
      <div class="car-track" data-track>
        {highlights.map((h) => (
          <article class="hl">
            <div class="hl-img"><img {...pic(h.image, '(min-width: 900px) 720px, 85vw')} alt="" loading="lazy" draggable="false" /></div>
            <h3>{h.title}</h3>
          </article>
        ))}
      </div>
      <div class="car-ctrl wrap">
        <button class="arrow-btn" data-prev aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg></button>
        <button class="arrow-btn" data-next aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    </div>
  </section>

  <!-- ============ Escape band ============ -->
  <section class="band">
    <div class="band-in">
      <img {...pic(home.band.image, '(min-width: 1800px) 1947px, 100vw')} alt="" loading="lazy" />
      <div class="band-copy">
        <h2 class="h-section" data-reveal>{home.band.title}</h2>
        <div class="row" data-reveal data-delay="0.1">
          <button class="btn" data-enquire>Build a farmhouse</button>
          <a class="btn soft" href="#resort">Build a resort</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Take a closer look (Apple-style viewer) ============ -->
  <section class="sec">
    <h2 class="h-section wrap" data-reveal>Take a closer look.</h2>

    <!-- Desktop: pills on the left, photo opens to the full panel -->
    <div class="cl wrap">
      <div class="cl-stage" data-cl data-state="idle">
        <div class="cl-media" aria-hidden="true">
          <img class="cl-img is-on" data-idle {...render(5, '(min-width: 1200px) 1100px, 100vw')} alt="" style="--fx:50%;--fy:50%;--z:1" />
          {features.map((f, i) => (
            <img class="cl-img" data-img={i} {...pic(f.image, '(min-width: 1440px) 1340px, 100vw')} alt="" loading="lazy" style={`--fx:${f.x}%;--fy:${f.y}%;--z:${f.zoom}`} />
          ))}
        </div>
        <div class="cl-nav">
          <button class="cl-arrow" data-cl-prev aria-label="Previous feature"><svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6" /></svg></button>
          <button class="cl-arrow" data-cl-next aria-label="Next feature"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></button>
        </div>
        <ul class="cl-list" role="list">
          {features.map((f) => (
            <li class="cl-item">
              <button class="cl-pill" aria-expanded="false">
                <span class="cl-plus" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 7v10M7 12h10" /></svg></span>
                <span>{f.name}</span>
              </button>
              <div class="cl-body"><p><strong>{f.name}.</strong> {f.text}</p></div>
            </li>
          ))}
        </ul>
        <button class="cl-close" data-cl-close aria-label="Close"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17" /></svg></button>
      </div>
    </div>

    <!-- Phones: a spring carousel of photo + caption -->
    <div class="car cl-m" data-carousel data-cl-mobile>
      <div class="car-track" data-track>
        {features.map((f) => (
          <article class="clm">
            <div class="clm-img"><img {...pic(f.image, '85vw')} alt="" loading="lazy" draggable="false" style={`object-position:${f.x}% 50%`} /></div>
            <p><strong>{f.name}.</strong> {f.text}</p>
          </article>
        ))}
      </div>
      <div class="dots" data-dots>{features.map((_, i) => <button aria-label={`Feature ${i + 1}`}></button>)}</div>
    </div>
  </section>

  <!-- ============ Models ============ -->
  <section class="sec">
    <div class="head wrap">
      <h2 class="h-section" data-reveal>{home.models.title}</h2>
      <a class="btn" href="/models" data-reveal>Explore Caves</a>
    </div>
    <div class="car" data-carousel>
      <div class="car-track" data-track>
        {models.map((m) => (
          <a class="model" href={m.href} draggable="false">
            <img {...pic(m.image, '(min-width: 900px) 420px, 80vw')} alt="" loading="lazy" draggable="false" />
            <div class="model-copy">
              <h3>{m.name}</h3>
              <p>{m.line}</p>
              {m.price && <span class="tag">{m.price}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Orion: a finished home ============ -->
  <section class="sec">
    <div class="head wrap">
      <div class="orion-head">
        <h2 class="h-section" data-reveal>{orion.title}</h2>
        <p class="lede" data-reveal data-delay="0.05">{orion.text}</p>
      </div>
    </div>
    <div class="car" data-carousel>
      <div class="car-track" data-track>
        {orion.photos.map((p) => {
          const m = meta(p.image);
          return <figure class="op" style={`aspect-ratio:${m.w}/${m.h}`}><img {...pic(p.image, '(min-width: 900px) 840px, 90vw')} alt={p.label} loading="lazy" draggable="false" /><figcaption>{p.label}</figcaption></figure>;
        })}
      </div>
      <div class="car-ctrl wrap">
        <button class="arrow-btn" data-prev aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg></button>
        <button class="arrow-btn" data-next aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    </div>
  </section>

  <!-- ============ Why Cave ============ -->
  <section class="sec mist">
    <div class="head wrap">
      <h2 class="h-section" data-reveal>{compare.title}</h2>
      <button class="btn" data-enquire data-reveal>Build a farmhouse</button>
    </div>
    <div class="wrap">
      <div class="cmp" data-reveal>
        <div class="cmp-col">
          <h3>Traditional way</h3>
          <p class="cmp-sub">Multiple teams. Multiple handovers.</p>
          {compare.rows.map((c) => (
            <div class="cmp-row">
              <span class="ico" aria-hidden="true">
                {c.icon === 'person' && <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c1-3.5 3.8-5 7-5s6 1.5 7 5" /></svg>}
                {c.icon === 'triangle' && <svg viewBox="0 0 24 24"><path d="M12 4l8.5 15h-17z" /><path d="M12 10v4M12 16.5v.5" /></svg>}
                {c.icon === 'helmet' && <svg viewBox="0 0 24 24"><path d="M4 16h16M6 16a6 6 0 0 1 12 0M12 7v4M9.5 8.2l.8 3M14.5 8.2l-.8 3" /></svg>}
                {c.icon === 'lamp' && <svg viewBox="0 0 24 24"><path d="M8 4h8l3 7H5zM12 11v7M8 20h8" /></svg>}
              </span>
              <div><b>{c.role}</b><span>{c.old}</span></div>
              <svg class="x" viewBox="0 0 24 24" aria-label="Not included"><path d="M7 7l10 10M17 7L7 17" /></svg>
            </div>
          ))}
        </div>
        <div class="cmp-col cave">
          <h3>The Cave way</h3>
          <p class="cmp-sub">One team. Everything included.</p>
          {compare.rows.map((c) => (
            <div class="cmp-row">
              <span class="tick" aria-label="Included"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" /></svg></span>
              <div><b>{c.role}</b><span>{c.cave}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Process ============ -->
  <section class="sec" data-nospring>
    <div class="wrap proc-pin" data-proc-pin style={`--n:${steps.length}`}>
     <div class="proc-stick" data-proc-stick>
      <h2 class="h-section center">A simple, beautiful process.</h2>
      <div class="proc" data-proc>
        <ol class="proc-list">
          {steps.map((s, i) => (
            <li><button class:list={{ on: i === 0 }} data-step={i}><span class="num">{i + 1}.</span> {s.name}<em>{s.text}</em></button></li>
          ))}
        </ol>
        <div class="proc-media">
          {steps.map((s, i) => <img class:list={{ on: i === 0, plan: isPlan(s.image) }} {...pic(s.image, '(min-width: 900px) 640px, 100vw')} alt={isPlan(s.image) ? 'Floor plan' : ''} loading="lazy" data-step-img={i} />)}
          <button class="btn" data-enquire>Build Cave</button>
        </div>
      </div>
     </div>
    </div>
  </section>

  <!-- ============ Promise ============ -->
  <section class="sec">
    <h2 class="h-section wrap" data-reveal>{promises.title}</h2>
    <div class="car" data-carousel>
      <div class="car-track" data-track>
        {promises.items.map((p) => <div class="promise"><p><b>{p.bold}</b> {p.text}</p></div>)}
      </div>
    </div>
  </section>

  <!-- ============ Resort ============ -->
  <section class="sec resort wrap" id="resort">
    <h2 class="h-section" data-reveal>Planning a resort?</h2>
    <p class="lede" data-reveal>We can build a cluster of Caves for stays and retreats. Tell us about the land and we will plan it with you.</p>
    <button class="btn" data-enquire data-reveal>Build a resort</button>
  </section>
</Base>

<style>
  .center { text-align: center; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .sec { padding-block: clamp(56px, 8vw, 112px); }
  .sec .h-section { margin-bottom: clamp(24px, 3vw, 40px); }
  .mist { background: var(--mist); }
  .h-display, .h-section { color: var(--brown); font-weight: 700; letter-spacing: -0.035em; }
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .head .h-section { margin: 0; }

  /* ---------- Hero ---------- */
  .hero { padding: clamp(12px, 1.6vw, 20px) var(--edge) 0; }
  /* Never wider than the render's own pixels, so it always stays sharp */
  .stage { position: relative; max-width: 1774px; margin: 0 auto; aspect-ratio: 2 / 1; border-radius: var(--r-xl); overflow: hidden; container-type: inline-size; background: var(--sand); }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; max-width: none; }
  .h-fg { z-index: 2; pointer-events: none; }
  .stamp {
    position: absolute; z-index: 1; left: 50%; top: 37%; translate: -50% -100%;
    font-family: var(--logo); font-weight: 800; letter-spacing: -0.045em; line-height: .8; white-space: nowrap;
    font-size: 21cqw; color: var(--brown);
    padding-bottom: .02em;
  }
  .hero-copy { display: grid; gap: 20px; padding: clamp(24px, 3.4vw, 48px) calc(var(--gutter) - var(--edge)) clamp(16px, 2vw, 24px); }
  .hero-copy .h-display { margin: 0; }
  .hero-side { display: grid; gap: 22px; align-content: end; }
  .lede { color: var(--grey); }
  @media (min-width: 900px) { .hero-copy { grid-template-columns: 1.2fr 1fr; align-items: end; } }
  @media (max-width: 700px) {
    /* Taller crop on phones; stamp and cut-out share the same crop so they stay aligned */
    .stage { aspect-ratio: 4 / 5; }
    .stage img { object-position: 46% 50%; }
    .stamp { font-size: 22.5cqw; top: 35%; }
  }

  /* ---------- About ---------- */
  .about { padding-block: clamp(56px, 8vw, 112px) 0; display: grid; gap: 16px; }
  .about-k { margin: 0; font-weight: 600; color: var(--brown); }
  .about-t { margin: 0; font-size: clamp(22px, 2.6vw, 36px); line-height: 1.3; letter-spacing: -0.02em; font-weight: 500; max-width: 30ch; color: var(--ink); }

  /* ---------- Carousels (shared) ---------- */
  .car { overflow: hidden; cursor: grab; user-select: none; }
  .car:active { cursor: grabbing; }
  .car-track { display: flex; gap: clamp(12px, 1.4vw, 20px); padding-inline: var(--gutter); will-change: transform; }
  .car-track > * { flex: none; }
  .car img { -webkit-user-drag: none; }
  .car-ctrl { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
  .arrow-btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--sand); transition: background-color .3s, opacity .3s; }
  .arrow-btn:hover { background: #e9e1d7; }
  .arrow-btn[disabled] { opacity: .35; pointer-events: none; }
  .arrow-btn svg { width: 20px; height: 20px; stroke: var(--brown); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  .hl { width: min(680px, 84vw); }
  .hl-img { aspect-ratio: 16 / 10; border-radius: var(--r-lg); overflow: hidden; background: var(--sand); }
  .hl-img img { width: 100%; height: 100%; object-fit: cover; }
  .hl h3 { margin: 16px 4px 0; font-size: clamp(17px, 1.5vw, 21px); font-weight: 600; color: var(--ink); letter-spacing: -0.01em; line-height: 1.3; }

  /* ---------- Band ---------- */
  .band { padding-inline: var(--edge); }
  .band-in { position: relative; max-width: 1947px; margin: 0 auto; aspect-ratio: 2.41 / 1; border-radius: var(--r-xl); overflow: hidden; }
  .band-in img { width: 100%; height: 100%; object-fit: cover; }
  .band-in::before { content: ''; position: absolute; inset: 0 0 45% 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(22, 15, 9, .55), rgba(22, 15, 9, 0)); }
  .band-copy { z-index: 2; position: absolute; inset: 0; display: grid; place-content: start center; justify-items: center; gap: 12px; padding-top: clamp(16px, 2.6vw, 44px); text-align: center; }
  .band-copy .h-section { font-size: clamp(28px, 3.4vw, 52px); color: #fff; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .band-copy .h-section { margin: 0; }
  @media (max-width: 700px) { .band-in { aspect-ratio: 4 / 5; } .band-in img { object-position: 30% 50%; } }

  /* ---------- Closer look: desktop viewer ---------- */
  .cl-stage { position: relative; aspect-ratio: 2.05 / 1; max-height: 640px; width: 100%; border-radius: 28px; background: var(--sand); overflow: hidden; isolation: isolate; --e: cubic-bezier(.32,.72,0,1); }
  .cl-media { position: absolute; inset: 0; clip-path: inset(7% 4% 7% 33% round 22px); transition: clip-path .9s var(--e); }
  .cl-stage[data-state="open"] .cl-media { clip-path: inset(0 0 0 0 round 0px); }
  .cl-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; max-width: none;
    transform-origin: var(--fx) var(--fy); transform: scale(calc(var(--z) * 1.04)); transition: opacity .7s ease, transform 1.3s var(--e); }
  .cl-img.is-on { opacity: 1; transform: scale(var(--z)); }
  .cl-list { position: absolute; z-index: 2; left: 64px; top: 50%; translate: 0 -50%; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; width: 340px; }
  .cl-item { border-radius: 28px; overflow: hidden; background: #ebe5dd; transition: background-color .5s ease; }
  .cl-stage[data-state="open"] .cl-item { background: rgba(246, 242, 237, .66); backdrop-filter: blur(20px) saturate(1.5); -webkit-backdrop-filter: blur(20px) saturate(1.5); }
  .cl-pill { display: flex; align-items: center; gap: 12px; height: 52px; padding: 0 22px 0 14px; font-size: 16px; font-weight: 600; white-space: nowrap; color: var(--ink); }
  .cl-plus { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid currentColor; transition: transform .5s var(--e); }
  .cl-plus svg, .cl-arrow svg, .cl-close svg { width: 16px; height: 16px; stroke: var(--ink); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .cl-pill:hover .cl-plus { transform: rotate(90deg); }
  .cl-body { display: none; width: 320px; padding: 20px 24px 22px; }
  .cl-body p { margin: 0; font-size: 16px; line-height: 1.45; font-weight: 500; color: #4a3a2e; opacity: 0; transform: translateY(6px); transition: opacity .4s ease .18s, transform .5s var(--e) .18s; }
  .cl-body strong { color: var(--ink); }
  .cl-item.is-open .cl-pill { display: none; }
  .cl-item.is-open .cl-body { display: block; cursor: pointer; }
  .cl-item.is-open.is-shown .cl-body p { opacity: 1; transform: none; }
  .cl-nav { position: absolute; z-index: 2; left: 22px; top: 50%; translate: 0 -50%; display: grid; gap: 10px; opacity: 0; pointer-events: none; transition: opacity .4s; }
  .cl-arrow, .cl-close { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(246,242,237,.75); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background-color .25s, transform .3s var(--e); }
  .cl-arrow:hover, .cl-close:hover { background: #fff; transform: scale(1.08); }
  .cl-arrow:disabled { opacity: .35; pointer-events: none; }
  .cl-close { position: absolute; z-index: 3; top: 18px; right: 18px; width: 36px; height: 36px; opacity: 0; pointer-events: none; transition: opacity .4s, background-color .25s, transform .3s var(--e); }
  .cl-stage[data-state="open"] :is(.cl-nav, .cl-close) { opacity: 1; pointer-events: auto; }

  /* ---------- Closer look: phone carousel ---------- */
  .cl-m { display: none; }
  .clm { width: 84vw; }
  .clm-img { aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; background: var(--sand); }
  .clm-img img { width: 100%; height: 100%; object-fit: cover; }
  .clm p { margin: 16px 4px 0; font-size: 16px; line-height: 1.45; color: #4a3a2e; }
  .clm strong { color: var(--ink); }
  .dots { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
  .dots button { width: 8px; height: 8px; border-radius: 99px; background: #d9d0c6; transition: width .4s var(--e, ease), background-color .3s; }
  .dots button.on { width: 22px; background: var(--brown); }
  @media (max-width: 760px) { .cl { display: none; } .cl-m { display: block; } }

  /* ---------- Models ---------- */
  .model { position: relative; display: block; width: min(420px, 80vw); aspect-ratio: 4 / 4.4; border-radius: var(--r-lg); overflow: hidden; background: var(--sand); color: #fff; }
  .model img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.32,.72,0,1); }
  .model:hover img { transform: scale(1.04); }
  .model::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(180deg, rgba(30,20,12,0), rgba(30,20,12,.62)); }
  .model-copy { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: 22px; display: grid; gap: 8px; justify-items: start; }
  .model h3 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; text-transform: uppercase; }
  .model p { margin: 0; font-size: 15px; line-height: 1.4; max-width: 28ch; opacity: .92; }
  .tag { margin-top: 6px; padding: 6px 14px; border-radius: 99px; background: rgba(255,255,255,.22); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: 13px; font-weight: 600; }
  .model.soon { color: var(--brown); }
  .model.soon::after { display: none; }

  /* ---------- Orion ---------- */
  .orion-head { display: grid; gap: 10px; max-width: 46ch; }
  .orion-head .lede { margin: 0; }
  .op { position: relative; margin: 0; height: clamp(340px, 40vw, 560px); border-radius: var(--r-lg); overflow: hidden; background: var(--sand); }
  .op img { width: 100%; height: 100%; object-fit: cover; }
  /* Phones: same-size tall cards so the next photo peeks in */
  @media (max-width: 700px) { .op { height: auto; width: 82vw; aspect-ratio: 4 / 5 !important; } }
  .op figcaption { position: absolute; left: 14px; bottom: 14px; padding: 6px 12px; border-radius: 99px; font-size: 13px; font-weight: 600; color: var(--ink);
    background: rgba(255,255,255,.72); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

  /* ---------- Compare ---------- */
  .cmp { display: grid; background: #fff; border-radius: var(--r-xl); overflow: hidden; }
  .cmp-col { padding: clamp(24px, 3vw, 40px); }
  .cmp-col h3 { margin: 0; font-size: clamp(24px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.02em; }
  .cave h3 { color: var(--brown); }
  .cmp-sub { margin: 6px 0 18px; color: var(--grey); }
  .cmp-row { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .cmp-row b { display: block; font-weight: 600; }
  .cmp-row span:not(.ico):not(.tick) { color: var(--grey); font-size: 14px; }
  .ico, .tick { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--sand); }
  .ico svg { width: 22px; height: 22px; stroke: var(--brown); stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .tick { width: 30px; height: 30px; background: var(--brown); margin-inline: 7px; }
  .tick svg { width: 18px; height: 18px; stroke: #fff; stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .x { width: 18px; height: 18px; stroke: var(--grey); stroke-width: 2; fill: none; stroke-linecap: round; }
  @media (min-width: 900px) { .cmp { grid-template-columns: 1fr 1fr; } .cave { border-left: 1px solid var(--line); } }
  @media (max-width: 899px) { .cave { border-top: 1px solid var(--line); } }

  /* ---------- Process ---------- */
  .proc { display: grid; background: var(--mist); border-radius: var(--r-xl); overflow: hidden; }
  .proc-list { list-style: none; margin: 0; padding: clamp(28px, 4vw, 56px); display: grid; gap: 6px; align-content: center; }
  .proc-list button { display: block; width: 100%; text-align: left; padding: 10px 0; font-size: clamp(18px, 1.6vw, 22px); color: var(--grey); transition: color .3s; }
  .proc-list button .num { display: inline-block; min-width: 1.6em; }
  .proc-list button em { display: block; max-height: 0; overflow: hidden; font-style: normal; font-size: 15px; color: var(--grey); padding-left: 1.6em; opacity: 0; transition: max-height .5s cubic-bezier(.32,.72,0,1), opacity .4s, margin .4s; }
  .proc-list button.on { color: var(--brown); font-weight: 700; }
  .proc-list button.on em { max-height: 4em; opacity: 1; margin-top: 6px; font-weight: 500; }
  .proc-media { position: relative; min-height: 320px; display: grid; place-items: center; }
  .proc-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease; }
  .proc-media img.on { opacity: 1; }
  .proc-media img.plan { object-fit: contain; background: #f3eee9; padding: 6%; box-sizing: border-box; }
  .proc-media:has(img.plan.on) .btn { display: none; }
  .proc-media .btn { position: relative; z-index: 1; }
  /* The card sticks under the header and scrolling walks through the steps */
  .proc-pin { height: calc(100svh + var(--n) * 42svh); }
  .proc-stick { position: sticky; top: calc(var(--header-h) + max(12px, (100svh - var(--header-h) - 760px) / 2)); }
  .proc-stick .h-section { margin-bottom: clamp(16px, 2vw, 28px); }
  .proc { height: min(600px, calc(100svh - var(--header-h) - 24px - clamp(60px, 9vw, 130px))); }
  @media (min-width: 900px) { .proc { grid-template-columns: 1fr 1.1fr; } }
  @media (max-width: 899px) {
    .proc { grid-template-rows: auto 1fr; }
    .proc-list { padding: 22px 24px 18px; gap: 0; }
    .proc-list button { padding: 7px 0; font-size: 18px; }
    .proc-list button em { font-size: 14px; }
    .proc-media { min-height: 0; }
  }

  /* ---------- Promise ---------- */
  .promise { width: min(360px, 78vw); padding: 28px; border-radius: var(--r-lg); background: var(--sand); }
  .promise p { margin: 0; font-size: 18px; line-height: 1.45; color: #4a3a2e; }
  .promise b { color: var(--brown); }

  /* ---------- Resort ---------- */
  .resort { display: grid; justify-items: start; gap: 18px; padding-bottom: clamp(72px, 9vw, 128px); }
  .resort .h-section { margin: 0; }
</style>

<script>
  import { gsap, ScrollTrigger, isMobile } from '../scripts/motion';
  import { carousel } from '../scripts/carousel';

  // ---- Hero: a gentle depth shift as you scroll (back moves more than front) ----
  gsap.timeline({ scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: 0.6 } })
    .fromTo('[data-h-bg]', { scale: 1.04 }, { scale: 1, ease: 'none' }, 0)
    .fromTo('[data-stamp]', { yPercent: 0 }, { yPercent: 18, ease: 'none' }, 0);
  gsap.from('[data-stamp]', { yPercent: 40, opacity: 0, duration: 1.4, ease: 'power3.out', delay: 0.2 });

  // ---- Carousels ----
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => carousel(el));


  // ---- Closer look (desktop) ----
  const stage = document.querySelector<HTMLElement>('[data-cl]');
  if (stage) {
    const items = [...stage.querySelectorAll<HTMLLIElement>('.cl-item')];
    const imgs = [...stage.querySelectorAll<HTMLImageElement>('[data-img]')];
    const idle = stage.querySelector<HTMLImageElement>('[data-idle]')!;
    const prev = stage.querySelector<HTMLButtonElement>('[data-cl-prev]')!;
    const next = stage.querySelector<HTMLButtonElement>('[data-cl-next]')!;
    let current = -1;
    // FLIP: remember each pill's box, change layout, then glide from old box to new
    const morph = (change: () => void) => {
      const before = items.map((li) => li.getBoundingClientRect());
      change();
      items.forEach((li, i) => {
        const a = before[i], b = li.getBoundingClientRect();
        gsap.fromTo(li, { x: a.left - b.left, y: a.top - b.top, width: a.width, height: a.height },
          { x: 0, y: 0, width: b.width, height: b.height, duration: 0.55, ease: 'power3.inOut', overwrite: true, clearProps: 'width,height,transform' });
      });
    };
    const show = (i: number) => {
      if (i === current) return;
      morph(() => {
        items.forEach((li, k) => {
          li.classList.toggle('is-open', k === i);
          li.classList.remove('is-shown');
          li.querySelector('.cl-pill')!.setAttribute('aria-expanded', String(k === i));
        });
        stage.dataset.state = i < 0 ? 'idle' : 'open';
      });
      idle.classList.toggle('is-on', i < 0);
      imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
      current = i;
      prev.disabled = i <= 0;
      next.disabled = i >= items.length - 1;
      if (i >= 0) setTimeout(() => items[i].classList.add('is-shown'), 120);
    };
    items.forEach((li, i) => {
      li.querySelector('.cl-pill')!.addEventListener('click', () => show(i));
      li.querySelector('.cl-body')!.addEventListener('click', () => show(-1));
    });
    prev.addEventListener('click', () => show(Math.max(0, current - 1)));
    next.addEventListener('click', () => show(Math.min(items.length - 1, current + 1)));
    stage.querySelector('[data-cl-close]')!.addEventListener('click', () => show(-1));
    window.addEventListener('keydown', (e) => {
      if (current < 0 || isMobile()) return;
      if (e.key === 'Escape') show(-1);
      if (e.key === 'ArrowDown') { e.preventDefault(); show(Math.min(items.length - 1, current + 1)); }
      if (e.key === 'ArrowUp') { e.preventDefault(); show(Math.max(0, current - 1)); }
    });
  }

  // ---- Process: click a step (or let it run) to swap the photo ----
  const proc = document.querySelector<HTMLElement>('[data-proc]');
  if (proc) {
    const btns = [...proc.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const pics = [...proc.querySelectorAll<HTMLImageElement>('[data-step-img]')];
    let at = 0;
    const set = (i: number) => {
      at = i;
      btns.forEach((b, k) => b.classList.toggle('on', k === i));
      pics.forEach((p, k) => p.classList.toggle('on', k === i));
    };
    const pin = document.querySelector<HTMLElement>('[data-proc-pin]')!;
    // Sticky card: scrolling walks through the steps; clicking a step scrolls to it
    const st = ScrollTrigger.create({
      trigger: pin, start: () => `top top+=${parseFloat(getComputedStyle(document.querySelector('[data-proc-stick]')!).top) || 0}`, end: 'bottom bottom', invalidateOnRefresh: true,
      onUpdate: (self) => { const i = Math.min(btns.length - 1, Math.floor(self.progress * btns.length)); if (i !== at) set(i); },
    });
    btns.forEach((b, i) => b.addEventListener('click', () => {
      (window as any).__lenis?.scrollTo(st.start + (st.end - st.start) * ((i + 0.5) / btns.length));
    }));
  }
</script>
