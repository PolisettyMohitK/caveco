---
import Base from '../../layouts/Base.astro';
import PlanMorph from '../../components/PlanMorph.astro';
import Accordion from '../../components/Accordion.astro';
import { models, included } from '../../data/models';

export function getStaticPaths() {
  return models.filter((m) => m.status !== 'soon').map((m) => ({ params: { slug: m.slug } }));
}
const { slug } = Astro.params;
const m = models.find((x) => x.slug === slug)!;
const live = models.filter((x) => x.status !== 'soon');
const next = live[(live.indexOf(m) + 1) % live.length];
const specs = included.map((g) => ({ q: g.title, a: g.items }));
const facts = [
  { k: 'Type', v: m.kind },
  { k: 'Built in', v: `${m.days} days` },
  { k: 'Size', v: m.area ?? 'Fitted to your land' },
  { k: 'Price', v: m.price ? `from ${m.price}` : 'Fixed after site visit' },
];
---
<Base title={m.name} page="models" description={`${m.name} by Cave Co. — ${m.kind}. ${m.blurb}`}>
  <section class="open-sky top">
    <a href="/models" class="link back"><span class="arrow">←</span> All models</a>
    <div class="top-grid">
      <h1 class="name" data-reveal>{m.name}</h1>
      <p class="lede" data-reveal data-delay=".08">{m.blurb}</p>
    </div>
  </section>

  <section class="island bleed hero-img">
    <div class="frame fill" data-opening="once">
      {m.cover ? <img src={m.cover} alt={`${m.name} exterior`} style={m.heroStyle} /> : <div class="ph"></div>}
    </div>
    <dl class="facts">
      {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
    </dl>
  </section>

  {m.finishes.length > 1 && (
    <section class="island">
      <div class="sec-head">
        <h2 class="h-section" data-reveal><span>One house,</span><span>your finish.</span></h2>
        <div class="side">
          <div class="chips" role="tablist" data-fin-tabs>
            {m.finishes.map((f, i) => (
              <button role="tab" class:list={['chip', { on: i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} data-fin={i}>{f.name}</button>
            ))}
          </div>
        </div>
      </div>
      <div class="frame fin-stage">
        {m.finishes.map((f, i) => f.src
          ? <img src={f.src} alt={`${m.name} — ${f.name}`} class:list={{ on: i === 0 }} data-fin-img={i} loading="lazy" style={f.style} />
          : <div class:list={['ph', { on: i === 0 }]} data-fin-img={i}></div>)}
      </div>
    </section>
  )}

  <section class="island blueprint">
    <PlanMorph title="Every room earns its place." />
  </section>

  {m.gallery.length > 1 && (
    <section class="island gal">
      {m.gallery.map((g, i) => (
        <figure class:list={['gal-item', { wide: i === 0 }]}>
          <div class="frame" data-opening="once"><img src={g.src} alt={g.label} loading="lazy" /></div>
          <figcaption class="small">{g.label}</figcaption>
        </figure>
      ))}
    </section>
  )}

  <section class="island spec">
    <div class="spec-l">
      <h2 class="h-section" data-reveal><span>What’s</span><span>included.</span></h2>
      <p class="lede">Everything below comes with {m.name}. No extras to buy later.</p>
    </div>
    <Accordion items={specs} id="spec" />
  </section>

  {next.slug !== m.slug && (
    <a href={`/models/${next.slug}`} class="island tint next">
      <span class="small">Next model</span>
      <span class="next-name">{next.name} <span class="arrow">→</span></span>
    </a>
  )}

  <div class="reqbar" data-reqbar>
    <div class="req-in">
      <div class="req-info"><strong>{m.name}</strong><span>{m.days} days · price fixed after site visit</span></div>
      <button class="btn btn-sm" data-enquire={m.name}>Request this model <span class="arrow">→</span></button>
    </div>
  </div>
</Base>

<style>
  .back { margin-bottom: 24px; }
  .top-grid { display: grid; gap: 20px; align-items: end; }
  @media (min-width: 1000px) { .top-grid { grid-template-columns: 1.4fr 1fr; } }
  .name { margin: 0; font-size: clamp(64px, 12vw, 180px); font-weight: 500; line-height: .88; letter-spacing: -0.06em; }
  .hero-img { display: grid; }
  .fill { height: min(78vh, 800px); border-radius: 0; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); }
  .facts div { background: var(--white); padding: 18px var(--pad); }
  .facts dt { font-size: 13px; color: var(--grey); }
  .facts dd { margin: 2px 0 0; font-size: 17px; font-weight: 500; }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(4, 1fr); } }

  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .fin-stage { height: min(70vh, 720px); }
  .fin-stage > * { position: absolute; inset: 0; opacity: 0; transition: opacity .9s var(--ease); }
  .fin-stage > .on { opacity: 1; }

  .blueprint { background: var(--sky-deep); color: var(--white); }

  .gal { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  .gal-item { margin: 0; }
  .gal-item .frame { aspect-ratio: 4 / 5; }
  .gal-item.wide { grid-column: 1 / -1; }
  .gal-item.wide .frame { aspect-ratio: 16 / 9; }
  .gal-item figcaption { margin-top: 8px; }
  @media (min-width: 900px) { .gal { grid-template-columns: repeat(4, 1fr); } .gal-item.wide { grid-column: span 4; } }

  .spec { display: grid; gap: 28px; }
  .spec-l { display: grid; gap: 16px; align-content: start; }
  @media (min-width: 1000px) { .spec { grid-template-columns: 1fr 1.4fr; gap: 64px; } }

  .next { display: flex; flex-direction: column; gap: 4px; }
  .next-name { font-size: clamp(44px, 7vw, 100px); font-weight: 500; letter-spacing: -0.05em; line-height: 1; transition: color .3s; }
  .next:hover .next-name { color: var(--red); }
  .next .arrow { display: inline-block; transition: transform .5s var(--ease); }
  .next:hover .arrow { transform: translateX(10px); }

  .reqbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: var(--edge); transform: translateY(120%); transition: transform .7s var(--ease); pointer-events: none; }
  .reqbar.show { transform: none; pointer-events: auto; }
  .req-in { display: flex; justify-content: space-between; align-items: center; gap: 16px; background: var(--ink); color: var(--white); border-radius: 20px; padding: 10px 10px 10px 22px; max-width: 720px; margin: 0 auto; box-shadow: 0 16px 50px rgba(20, 50, 80, .25); }
  .req-in .btn { border-color: var(--white); }
  .req-info { display: flex; flex-direction: column; }
  .req-info span { font-size: 13px; color: rgba(255,255,255,.55); }
  @media (max-width: 520px) { .req-info span { display: none; } }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-fin]');
  const imgs = document.querySelectorAll<HTMLElement>('[data-fin-img]');
  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      tabs.forEach((x) => { x.classList.toggle('on', x === t); x.setAttribute('aria-selected', String(x === t)); });
      imgs.forEach((im) => im.classList.toggle('on', im.dataset.finImg === t.dataset.fin));
    }),
  );

  const bar = document.querySelector<HTMLElement>('[data-reqbar]')!;
  const footer = document.querySelector('footer')!;
  const update = () => {
    const past = window.scrollY > window.innerHeight * 0.7;
    const nearEnd = footer.getBoundingClientRect().top < window.innerHeight;
    bar.classList.toggle('show', past && !nearEnd);
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
