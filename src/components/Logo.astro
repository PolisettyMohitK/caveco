---
// Mock wordmark matching the Instagram logo: "CAVE CO." in a wide bold geometric sans.
// Swap for the client's real logo file when it arrives — TODO(client).
interface Props { size?: 'sm' | 'lg'; }
const { size = 'sm' } = Astro.props;
---
<span class:list={['logo', size]} aria-label="Cave Co.">CAVE CO.</span>
<style>
  .logo {
    display: inline-block;
    font-family: var(--logo);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--brown);
    line-height: 1;
    white-space: nowrap;
  }
  .sm { font-size: 22px; }
  .lg { font-size: clamp(52px, 12vw, 180px); letter-spacing: 0; }
</style>
