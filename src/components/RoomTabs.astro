---
// Interior viewer from the client's Figma: one large render with frosted room tabs on top.
// Tabs (or a swipe) crossfade between rooms.
import { meta, pic } from '../data/media';
interface Props { rooms: { image: string; label: string }[]; name: string; title?: string }
const { rooms, name, title = 'Inside.' } = Astro.props;
---
<section class="rt" data-rt>
  <h2 class="h-section rt-title" data-reveal>{title}</h2>
  <div class="rt-stage" data-rt-stage style={`max-width:${Math.min(...rooms.map((r) => meta(r.image).w))}px`}>
    {rooms.map((r, i) => {
      const p = meta(r.image);
      return (
        <img class:list={['rt-img', { on: i === 0 }]} data-rt-img={i}
          {...pic(r.image, `(min-width: ${p.w}px) ${p.w}px, 100vw`)} alt={`${name}: ${r.label}`} loading={i ? 'lazy' : undefined} draggable="false" />
      );
    })}
    <div class="rt-tabs" role="tablist" aria-label="Rooms">
      {rooms.map((r, i) => (
        <button role="tab" class:list={['rt-tab', { on: i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} data-rt-tab={i}>{r.label}</button>
      ))}
    </div>
    <div class="rt-count" aria-hidden="true"><span data-rt-n>1</span> / {rooms.length}</div>
  </div>
</section>

<style>
  .rt { padding-block: clamp(56px, 8vw, 112px); padding-inline: var(--edge); }
  .rt-title { margin: 0 0 clamp(20px, 2.6vw, 36px); padding-inline: calc(var(--gutter) - var(--edge)); box-sizing: border-box; color: var(--brown); font-weight: 700; letter-spacing: -0.035em; }
  .rt-stage { position: relative; max-width: 1920px; margin: 0 auto; aspect-ratio: 16 / 9; border-radius: var(--r-xl); overflow: hidden; background: var(--sand); touch-action: pan-y; user-select: none; }
  @media (max-width: 700px) { .rt-stage { aspect-ratio: 4 / 5; } }
  .rt-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.03);
    transition: opacity 1s cubic-bezier(.32,.72,0,1), transform 1.6s cubic-bezier(.32,.72,0,1); -webkit-user-drag: none; }
  .rt-img.on { opacity: 1; transform: none; }

  .rt-tabs { position: absolute; top: clamp(12px, 1.6vw, 22px); left: 50%; transform: translateX(-50%); max-width: calc(100% - 24px);
    display: flex; gap: 2px; padding: 4px; border-radius: 14px; overflow-x: auto; scrollbar-width: none;
    background: rgba(70, 60, 52, .38); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2); }
  .rt-tabs::-webkit-scrollbar { display: none; }
  .rt-tab { flex: none; padding: 8px 14px; border-radius: 10px; font-size: 14px; font-weight: 600; color: rgba(255,255,255,.72); white-space: nowrap; transition: color .4s, background-color .4s; }
  .rt-tab:hover { color: #fff; }
  .rt-tab.on { color: #fff; background: rgba(255,255,255,.18); }
  .rt-count { position: absolute; right: 16px; bottom: 14px; padding: 6px 12px; border-radius: 99px; font-size: 13px; font-weight: 600; color: #fff;
    background: rgba(40, 30, 24, .35); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); font-variant-numeric: tabular-nums; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLElement>('[data-rt-img]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-rt-tab]')];
    const count = root.querySelector<HTMLElement>('[data-rt-n]')!;
    const stage = root.querySelector<HTMLElement>('[data-rt-stage]')!;
    let at = 0;
    const go = (i: number) => {
      at = (i + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('on', k === at));
      tabs.forEach((t, k) => { t.classList.toggle('on', k === at); t.setAttribute('aria-selected', k === at ? 'true' : 'false'); });
      tabs[at].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      count.textContent = String(at + 1);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    // swipe between rooms
    let x0 = 0, y0 = 0, down = false;
    stage.addEventListener('pointerdown', (e) => { if ((e.target as HTMLElement).closest('.rt-tabs')) return; down = true; x0 = e.clientX; y0 = e.clientY; });
    window.addEventListener('pointerup', (e) => {
      if (!down) return; down = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(at + (dx < 0 ? 1 : -1));
    });
  });
</script>
