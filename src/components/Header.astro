---
import Logo from './Logo.astro';
interface Props { page?: string; }
const { page } = Astro.props;
const links = [
  { href: '/models', label: 'Models', key: 'models' },
  { href: '/90-days', label: '90 Days', key: 'days' },
  { href: '/projects', label: 'Projects', key: 'projects' },
];
---
<header class="header">
  <!-- Floating glass island. The menu overlay sits outside it, because backdrop-filter
       would otherwise trap the fixed overlay inside the bar. -->
  <div class="bar" data-bar>
    <a href="/" class="home" aria-label="Cave Co. home"><Logo /></a>

    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: page === l.key }]}>{l.label}</a>
      ))}
    </nav>

    <div class="right">
      {page === 'days' && (
        <span class="daychip" aria-hidden="true">Day <b data-daychip>00</b></span>
      )}
      <button class="btn btn-sm enquire" data-enquire>Enquire <span class="arrow">→</span></button>
      <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="site-menu" data-menu aria-hidden="true">
    <nav class="menu-nav" aria-label="Mobile">
      <a href="/" class:list={{ active: page === 'home' }}>Home</a>
      {links.map((l) => <a href={l.href} class:list={{ active: page === l.key }}>{l.label}</a>)}
    </nav>
    <div class="menu-foot">
      <button class="btn" data-enquire>Enquire <span class="arrow">→</span></button>
      <a class="link" href="https://www.instagram.com/the_cave_co/" target="_blank" rel="noopener">Instagram <span class="arrow">↗</span></a>
    </div>
  </div>
</header>

<style>
  .header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; pointer-events: none; }
  .bar {
    pointer-events: auto; position: relative; z-index: 2;
    margin: var(--header-top) var(--edge) 0;
    height: var(--header-h);
    display: flex; align-items: center; gap: 24px;
    padding: 0 10px 0 22px;
    border-radius: 20px;
    background: rgba(255, 255, 255, .66);
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 8px 30px rgba(40, 80, 120, .08);
  }
  .home { margin-right: auto; }
  .nav { display: none; gap: 6px; }
  .nav-link { padding: 8px 14px; border-radius: 12px; font-size: 15px; color: var(--grey); transition: color .3s, background-color .3s, border-radius .4s var(--ease); }
  .nav-link:hover { color: var(--ink); background: rgba(255,255,255,.7); border-radius: 999px; }
  .nav-link.active { color: var(--ink); background: var(--white); }
  .right { display: flex; align-items: center; gap: 8px; }
  .daychip { display: none; font-size: 14px; color: var(--grey); padding: 0 10px; font-variant-numeric: tabular-nums; }
  .daychip b { color: var(--ink); font-weight: 600; }
  .menu-btn { width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; border-radius: 12px; }
  .menu-btn span { display: block; width: 20px; height: 1.5px; background: var(--ink); transition: transform .45s var(--ease); }
  .menu-btn[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  /* Mobile menu: a full-screen sky with a white island of links */
  .menu {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    padding: calc(var(--header-top) + var(--header-h) + var(--gap)) var(--edge) var(--edge);
    background: linear-gradient(180deg, var(--sky-top), var(--sky-low));
    opacity: 0; transition: opacity .5s var(--ease);
    display: flex; flex-direction: column; gap: var(--gap);
  }
  .menu.open { opacity: 1; pointer-events: auto; }
  .menu-nav { background: var(--white); border-radius: var(--r-xl); padding: 12px 24px; display: grid; }
  .menu-nav a {
    font-size: clamp(34px, 9vw, 52px); font-weight: 500; letter-spacing: -0.04em; line-height: 1;
    padding: 18px 0; border-bottom: 1px solid var(--line);
    transform: translateY(16px); opacity: 0; transition: transform .6s var(--ease), opacity .6s var(--ease), color .3s;
  }
  .menu-nav a:last-child { border-bottom: 0; }
  .menu-nav a.active { color: var(--grey); }
  .menu.open .menu-nav a { transform: none; opacity: 1; }
  .menu.open .menu-nav a:nth-child(2) { transition-delay: .05s; }
  .menu.open .menu-nav a:nth-child(3) { transition-delay: .1s; }
  .menu.open .menu-nav a:nth-child(4) { transition-delay: .15s; }
  .menu-foot { background: var(--white); border-radius: var(--r-xl); padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

  @media (min-width: 900px) {
    .nav { display: flex; }
    .menu-btn, .menu { display: none; }
    .daychip { display: inline-block; }
  }
  @media (max-width: 899px) {
    .bar { padding-left: 18px; gap: 8px; }
    .enquire { padding: 0 14px; }
  }
</style>

<script>
  import { lockScroll } from '../scripts/motion';
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    lockScroll(open);
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a, [data-enquire]').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('open')) set(false); });
</script>
