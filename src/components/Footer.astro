---
import { site, waLink } from '../data/site';
---
<footer class="footer">
  <div class="top">
    <div class="brand">
      <p>Farmhouses designed, made and installed by one team, around Hyderabad and across Telangana.</p>
      <button class="btn" data-enquire>Build Cave</button>
    </div>
    <div class="col">
      <h3>Explore</h3>
      <a href="/models">Models</a>
      <a href="/#about">About</a>
      <a href="/#resort">Resort</a>
    </div>
    <div class="col">
      <h3>Talk</h3>
      {site.phones.map((p) => <a href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}
      <a href={waLink()} target="_blank" rel="noopener">WhatsApp</a>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </div>
    <div class="col">
      <h3>Visit</h3>
      <p>{site.hub.name}<br /><span>{site.hub.area}</span></p>
    </div>
  </div>
  <a href="/" class="mark" aria-label="Cave Co. home" ><span>CAVE CO.</span></a>
  <div class="meta">
    <span>© {new Date().getFullYear()} Cave Company</span>
    <span>Designed, made and installed in India</span>
  </div>
</footer>

<style>
  .footer { background: var(--mist); padding: clamp(48px, 6vw, 88px) var(--gutter) 28px; }
  .top { display: grid; gap: 36px; grid-template-columns: 1fr 1fr; }
  .brand { grid-column: 1 / -1; display: grid; gap: 16px; justify-items: start; max-width: 380px; }
  /* Big wordmark that spans the footer, edge to edge */
  .mark { display: block; margin: clamp(40px, 6vw, 88px) 0 0; container-type: inline-size; color: var(--brown); }
  .mark span { display: block; font-family: var(--logo); font-weight: 800; letter-spacing: -0.055em; line-height: .78;
    font-size: 23.6cqw; white-space: nowrap; text-align: center; padding-top: .04em; translate: -0.02em 0; }
  .brand p { margin: 0; color: var(--grey); }
  .col { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; font-size: 15px; }
  .col h3 { margin: 0 0 4px; font-size: 13px; font-weight: 600; color: var(--brown); }
  .col p { margin: 0; }
  .col span { color: var(--grey); }
  .col a { transition: color .3s; }
  .col a:hover { color: var(--brown); }
  .meta { margin: clamp(20px, 2.6vw, 36px) 0 0; padding-top: 20px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--grey); }
  @media (min-width: 900px) { .top { grid-template-columns: 1.6fr 1fr 1fr 1fr; } .brand { grid-column: auto; } }
</style>
