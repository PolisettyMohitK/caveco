---
// Process as a slider (client's Figma, model page): a filmstrip of photos, a track with a dot,
// and the step names under it. Scroll-driven: the section pins and the strip glides smoothly
// from step to step as you scroll; the step on the dot is big and bold with a line of detail,
// and its neighbours fade with distance. Clicking a step, dragging and arrow keys also work.
import { steps } from '../data/models';
import { pic, isPlan } from '../data/media';
interface Props { title?: string }
const { title = 'A simple, beautiful process.' } = Astro.props;
---
<section class="ps" data-ps data-nospring style={`--n:${steps.length}`}>
  <div class="ps-stick">
    <h2 class="h-section ps-title">{title}</h2>
    <div class="ps-film" data-ps-film tabindex="0" aria-roledescription="carousel" aria-label="Process steps">
      <div class="ps-strip" data-ps-strip>
        {steps.map((s, i) => (
          <div class:list={['ps-frame', { plan: isPlan(s.image) }]} data-ps-frame={i} aria-hidden={i ? 'true' : 'false'}>
            <img {...pic(s.image, '(min-width: 900px) 62vw, 80vw')} alt={`Step ${i + 1}: ${s.name}`} loading={i < 2 ? undefined : 'lazy'} draggable="false" />
          </div>
        ))}
      </div>
    </div>
    <div class="ps-track" data-ps-track role="slider" tabindex="0" aria-label="Process step" aria-valuemin="1" aria-valuemax={steps.length} aria-valuenow="1">
      <span class="ps-rail"><i data-ps-fill></i>{steps.map((_, i) => <b style={`left:${steps.length > 1 ? (i / (steps.length - 1)) * 100 : 0}%`}></b>)}</span>
      <span class="ps-dot" data-ps-dot></span>
    </div>
    <div class="ps-labels">
      <div class="ps-row" data-ps-row>
        {steps.map((s, i) => <button class="ps-lab" data-ps-lab={i}>{s.name}</button>)}
      </div>
    </div>
    <p class="ps-detail" data-ps-detail aria-live="polite">{steps[0].text}</p>
  </div>
  <script type="application/json" data-ps-text set:html={JSON.stringify(steps.map((s) => s.text))} />
</section>

<style>
  /* tall wrapper: each step gets a stretch of scroll; the inside stays pinned */
  .ps { position: relative; height: calc(100svh + (var(--n) - 1) * 42svh); }
  .ps-stick { position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); overflow: hidden;
    display: flex; flex-direction: column; justify-content: center; padding-block: clamp(12px, 2vw, 28px); box-sizing: border-box; }
  .ps-title { text-align: center; margin: 0 auto clamp(18px, 2.6vw, 36px); padding-inline: var(--pad); color: var(--brown); font-weight: 700; letter-spacing: -0.035em; }

  .ps-film { cursor: grab; user-select: none; outline: none; touch-action: pan-y; }
  .ps-film:active { cursor: grabbing; }
  .ps-strip { display: flex; gap: clamp(12px, 1.4vw, 20px); will-change: transform; }
  .ps-frame { flex: none; width: min(60vw, 960px, calc((100svh - var(--header-h) - 300px) * 16 / 9)); aspect-ratio: 16 / 9; border-radius: var(--r-xl); overflow: hidden; background: var(--sand); will-change: transform, opacity; }
  .ps-frame img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; pointer-events: none; }
  .ps-frame.plan { background: #f3eee8; }
  .ps-frame.plan img { object-fit: contain; padding: 5%; box-sizing: border-box; }
  @media (max-width: 700px) { .ps-frame { width: 80vw; aspect-ratio: 4 / 3.4; } }

  /* scrubber: drag the dot (mouse or finger) or click anywhere on the line */
  .ps-track { position: relative; margin: clamp(14px, 2vw, 28px) auto 0; width: min(560px, 76vw); padding: 16px 0; cursor: pointer; touch-action: none; outline: none; }
  .ps-rail { position: relative; display: block; height: 3px; border-radius: 3px; background: var(--line); }
  .ps-rail i { position: absolute; inset: 0; border-radius: 3px; background: var(--brown); opacity: .45; transform-origin: left; transform: scaleX(var(--p, 0)); }
  .ps-rail b { position: absolute; top: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: #d8cfc5; }
  .ps-dot { position: absolute; top: 50%; left: calc(var(--p, 0) * 100%); width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--brown);
    box-shadow: 0 0 0 5px rgba(90, 58, 36, .14); cursor: grab; transition: transform .3s cubic-bezier(.32,.72,0,1), box-shadow .3s; }
  .ps-track:hover .ps-dot, .ps-track:focus-visible .ps-dot { transform: scale(1.15); box-shadow: 0 0 0 8px rgba(90, 58, 36, .14); }
  .ps-track.drag .ps-dot { transform: scale(1.3); cursor: grabbing; }
  .ps-track.drag { cursor: grabbing; }

  .ps-labels { margin-top: 16px; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); }
  .ps-row { display: flex; align-items: baseline; gap: clamp(34px, 4vw, 64px); width: max-content; will-change: transform; }
  .ps-lab { font-size: clamp(15px, 1.3vw, 18px); font-weight: 500; color: var(--grey); white-space: nowrap; padding: 4px 2px; transition: color .45s cubic-bezier(.32,.72,0,1), font-weight .45s; }
  .ps-lab:hover { color: var(--ink); }
  .ps-lab.on { font-weight: 700; color: var(--brown); letter-spacing: -0.02em; }
  .ps-detail { text-align: center; margin: 10px auto 0; padding-inline: var(--pad); max-width: 44ch; color: var(--grey); min-height: 3em; }
  .ps-detail.swap { animation: ps-in .5s cubic-bezier(.32,.72,0,1); }
  @keyframes ps-in { from { opacity: 0; transform: translateY(6px); } }
</style>

<script>
  import { ScrollTrigger } from '../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((root) => {
    const film = root.querySelector<HTMLElement>('[data-ps-film]')!;
    const strip = root.querySelector<HTMLElement>('[data-ps-strip]')!;
    const frames = [...root.querySelectorAll<HTMLElement>('[data-ps-frame]')];
    const row = root.querySelector<HTMLElement>('[data-ps-row]')!;
    const labs = [...root.querySelectorAll<HTMLButtonElement>('[data-ps-lab]')];
    const detail = root.querySelector<HTMLElement>('[data-ps-detail]')!;
    const track = root.querySelector<HTMLElement>('[data-ps-track]')!;
    const text: string[] = JSON.parse(root.querySelector('[data-ps-text]')!.textContent || '[]');
    const n = frames.length;
    let pos = 0;      // shown position 0..n-1 (follows the scroll on a spring)
    let target = 0;   // where the scroll says we are
    let vel = 0, raf = 0, lastT = 0;
    let shown = -1;

    // measured centres (frames and labels), refreshed on resize
    let fc: number[] = [], lc: number[] = [], lw: number[] = [];
    const measure = () => {
      fc = frames.map((f) => f.offsetLeft + f.offsetWidth / 2);
      labs.forEach((l) => l.style.fontSize = '');
      lc = labs.map((l) => l.offsetLeft + l.offsetWidth / 2);
      lw = labs.map((l) => l.offsetWidth);
    };
    const lerp = (a: number[], f: number) => { const i = Math.floor(f), t = f - i; return i >= n - 1 ? a[n - 1] : a[i] + (a[i + 1] - a[i]) * t; };

    const render = () => {
      const half = film.clientWidth / 2;
      strip.style.transform = `translate3d(${half - lerp(fc, pos)}px,0,0)`;
      frames.forEach((f, k) => {
        const d = Math.min(1, Math.abs(k - pos));
        f.style.opacity = String(1 - d * 0.55);
        f.style.transform = `scale(${1 - d * 0.06})`;
      });
      // the label on the dot grows; neighbours fade with distance
      labs.forEach((l, k) => {
        const d = Math.abs(k - pos);
        const s = 1 + Math.max(0, 1 - d) * 0.5;
        l.style.transform = `scale(${s})`;
        l.style.opacity = String(Math.max(0.3, 1 - Math.max(0, d - 1) * 0.35));
      });
      row.style.transform = `translate3d(${row.parentElement!.clientWidth / 2 - lerp(lc, pos)}px,0,0)`;
      const near = Math.round(pos);
      if (near !== shown) {
        shown = near;
        labs.forEach((l, k) => l.classList.toggle('on', k === near));
        frames.forEach((f, k) => f.setAttribute('aria-hidden', k === near ? 'false' : 'true'));
        detail.textContent = text[near];
        detail.classList.remove('swap'); void detail.offsetWidth; detail.classList.add('swap');
      }
      track.style.setProperty('--p', String(n > 1 ? pos / (n - 1) : 1));
      track.setAttribute('aria-valuenow', String(near + 1));
    };

    // Spring between the scroll position and what's shown: soft glide, settles with a faint breath.
    // Timed in seconds so it feels the same at 60Hz and 120Hz.
    const W = 9, Z = 0.82; // natural frequency (rad/s), damping ratio
    const tick = (now: number) => {
      const dt = Math.min(0.032, (now - (lastT || now - 16)) / 1000);
      lastT = now;
      for (let k = 0; k < 2; k++) { const h = dt / 2; vel += (W * W * (target - pos) - 2 * Z * W * vel) * h; pos += vel * h; }
      if (Math.abs(vel) < 0.002 && Math.abs(target - pos) < 0.0015) { pos = target; vel = 0; raf = 0; render(); return; }
      render();
      raf = requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf) { lastT = 0; raf = requestAnimationFrame(tick); } };

    // labels scale around their centre, so give them room
    labs.forEach((l) => { l.style.transformOrigin = '50% 70%'; });

    const st = ScrollTrigger.create({
      trigger: root, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
      onUpdate: (self) => { target = self.progress * (n - 1); kick(); },
      onRefresh: () => { measure(); render(); },
    });
    // when scrolling stops between two steps, glide on to the nearest one
    ScrollTrigger.addEventListener('scrollEnd', () => {
      if (scrubbing || down) return;
      const y = window.scrollY;
      if (y <= st.start + 1 || y >= st.end - 1) return;
      const k = Math.round(target);
      if (Math.abs(k - target) > 0.01) scrollToStep(k);
    });

    // jump the page to a step (the strip follows the scroll)
    const lenis = () => (window as any).__lenis;
    const scrollToStep = (i: number) => {
      const k = Math.max(0, Math.min(n - 1, i));
      const y = st.start + (st.end - st.start) * (n > 1 ? k / (n - 1) : 0);
      lenis() ? lenis().scrollTo(y, { duration: 0.9, easing: (t: number) => 1 - Math.pow(1 - t, 3) }) : window.scrollTo({ top: y, behavior: 'smooth' });
    };
    labs.forEach((b, i) => b.addEventListener('click', () => scrollToStep(i)));
    frames.forEach((f, i) => f.addEventListener('click', () => { if (!dragged && i !== Math.round(pos)) scrollToStep(i); }));
    film.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); scrollToStep(Math.round(pos) + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); scrollToStep(Math.round(pos) - 1); }
    });

    // Drag / swipe sideways: moves the page, so the strip glides with your finger
    let x0 = 0, y0 = 0, s0 = 0, down = false, horiz = false, dragged = false;
    film.addEventListener('pointerdown', (e) => { down = true; horiz = false; dragged = false; x0 = e.clientX; y0 = e.clientY; s0 = window.scrollY; });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!horiz && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) horiz = true;
      if (!horiz) return;
      dragged = true;
      const perStep = (st.end - st.start) / Math.max(1, n - 1);
      const y = s0 - dx * (perStep / Math.max(200, frames[0].offsetWidth));
      lenis() ? lenis().scrollTo(y, { immediate: true }) : window.scrollTo(0, y);
    });
    const up = () => {
      if (!down) return;
      down = false;
      if (horiz) scrollToStep(Math.round(pos)); // settle on the nearest step
      setTimeout(() => { dragged = false; }, 0);
    };
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    // Scrubber: press on the line or the dot and drag; the strip follows instantly, release settles
    const scrubTo = (clientX: number) => {
      const r = track.getBoundingClientRect();
      const f = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
      const y = st.start + (st.end - st.start) * f;
      lenis() ? lenis().scrollTo(y, { immediate: true }) : window.scrollTo(0, y);
    };
    let scrubbing = false;
    track.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      scrubbing = true;
      track.setPointerCapture(e.pointerId);
      track.classList.add('drag');
      scrubTo(e.clientX);
    });
    track.addEventListener('pointermove', (e) => { if (scrubbing) scrubTo(e.clientX); });
    const endScrub = () => {
      if (!scrubbing) return;
      scrubbing = false;
      track.classList.remove('drag');
      scrollToStep(Math.round(pos));
    };
    track.addEventListener('pointerup', endScrub);
    track.addEventListener('pointercancel', endScrub);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); scrollToStep(Math.round(pos) + 1); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); scrollToStep(Math.round(pos) - 1); }
    });

    // trackpad sideways swipe
    film.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      const y = window.scrollY + e.deltaX * 1.4;
      lenis() ? lenis().scrollTo(y, { immediate: true }) : window.scrollTo(0, y);
    }, { passive: false });

    measure(); render();
    window.addEventListener('load', () => { measure(); render(); });
  });
</script>
