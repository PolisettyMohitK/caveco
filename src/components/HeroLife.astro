---
// Life in the hero render: butterflies over the garden and a soft breeze
// (drifting pollen, a few tumbling leaves, faint wind trails). Sits inside .stage.
const flies = [
  { c: '#f7ecd6', e: '#b98a52' },
  { c: '#f0c37f', e: '#8a5a2b' },
  { c: '#fbf7ef', e: '#a88b6a' },
  { c: '#e9a55c', e: '#7a4a22' },
  { c: '#f7ecd6', e: '#b98a52' },
];
---
<div class="life" aria-hidden="true" data-life>
  <canvas class="wind" data-wind></canvas>
  {flies.map((f) => (
    <svg class="bf" viewBox="-12 -11 24 22" style={`--c:${f.c};--e:${f.e}`} data-bf>
      <g class="w"><path d="M0-1C-2-9-10-11-11-5C-12 0-5 1 0 0Z" /><path d="M0 0C-4 1-9 3-8 7C-6 10-1 6 0 1Z" /></g>
      <g transform="scale(-1,1)"><g class="w"><path d="M0-1C-2-9-10-11-11-5C-12 0-5 1 0 0Z" /><path d="M0 0C-4 1-9 3-8 7C-6 10-1 6 0 1Z" /></g></g>
      <path class="body" d="M0-4V5" />
    </svg>
  ))}
</div>

<style>
  .life { position: absolute; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
  .wind { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bf { position: absolute; left: 0; top: 0; width: 24px; height: 22px; overflow: visible; opacity: 0; will-change: transform; filter: drop-shadow(0 2px 2px rgba(40, 28, 14, .18)); }
  .bf path { fill: var(--c); stroke: var(--e); stroke-width: .7; stroke-linejoin: round; }
  .bf .body { stroke: #3b2a1c; stroke-width: 1.6; stroke-linecap: round; fill: none; }
  .bf .w { transform-box: view-box; transform-origin: 50% 50%; animation: flap var(--flap, .2s) ease-in-out infinite alternate; }
  @keyframes flap { from { transform: scaleX(1); } to { transform: scaleX(.16); } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-life]');
  // Same rule as motion.ts: the site plays its motion even with reduce-motion on.
  const reduced = false;
  if (root && !reduced) {
    const stage = root.parentElement as HTMLElement;
    const cv = root.querySelector<HTMLCanvasElement>('[data-wind]')!;
    const ctx = cv.getContext('2d')!;
    const els = [...root.querySelectorAll<SVGElement>('[data-bf]')];
    const IW = 1774, IH = 887; // the hero render's pixels
    const rnd = (a: number, b: number) => a + Math.random() * (b - a);

    // Map a point on the render (0..1) to stage pixels, matching object-fit: cover + object-position.
    let W = 0, H = 0, s = 1, ox = 0, oy = 0, dpr = 1;
    const fit = () => {
      W = stage.clientWidth; H = stage.clientHeight; dpr = Math.min(2, devicePixelRatio || 1);
      cv.width = W * dpr; cv.height = H * dpr;
      s = Math.max(W / IW, H / IH);
      const px = parseFloat(getComputedStyle(stage.querySelector('img')!).objectPosition) / 100 || 0.5;
      ox = (W - IW * s) * px; oy = (H - IH * s) * 0.5;
    };
    const at = (fx: number, fy: number) => ({ x: ox + fx * IW * s, y: oy + fy * IH * s });
    const mobile = () => W < 700;

    // ---- Wind: one gusty strength shared by everything ----
    let t = 0;
    const wind = () => 1 + 0.55 * Math.sin(t * 0.37) + 0.35 * Math.sin(t * 0.91 + 1.3) + 0.25 * Math.max(0, Math.sin(t * 0.23 - 0.7)) * 3;

    // ---- Butterflies: wander between spots in the garden, now and then rest on the hedges ----
    type Fly = { el: SVGElement; x: number; y: number; vx: number; vy: number; tx: number; ty: number; rest: number; face: number; seed: number };
    const zone = () => ({ x0: 0.03, x1: 0.97, y0: mobile() ? 0.56 : 0.6, y1: 0.95 });
    const pick = (f: Fly) => {
      const z = zone();
      // keep targets inside what's actually visible on screen
      const a = at(z.x0, z.y0), b = at(z.x1, z.y1);
      f.tx = Math.max(24, Math.min(W - 24, rnd(a.x, b.x)));
      f.ty = Math.max(a.y, Math.min(H - 24, rnd(a.y, b.y)));
    };
    const flies: Fly[] = els.map((el, i) => {
      const f = { el, x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, rest: 0, face: 1, seed: Math.random() * 100 } as Fly;
      return f;
    });
    const placeFlies = () => {
      flies.forEach((f, i) => {
        const show = !mobile() || i < 4;
        f.el.style.display = show ? '' : 'none';
        pick(f); f.x = f.tx; f.y = f.ty; pick(f);
        f.el.style.setProperty('--flap', `${rnd(0.15, 0.22).toFixed(2)}s`);
      });
    };

    // ---- Pollen, leaves and wind trails ----
    type Mote = { x: number; y: number; r: number; d: number; ph: number; a: number };
    type Leaf = { x: number; y: number; d: number; rot: number; spin: number; ph: number; c: string };
    type Trail = { x: number; y: number; len: number; amp: number; life: number; ttl: number; sp: number };
    let motes: Mote[] = [], leaves: Leaf[] = [], trails: Trail[] = [];
    const seedAir = () => {
      const n = mobile() ? 26 : 46;
      motes = Array.from({ length: n }, () => ({ x: rnd(0, W), y: rnd(H * 0.2, H), r: rnd(0.8, 2.1), d: rnd(0.4, 1), ph: rnd(0, 6.3), a: rnd(0.35, 0.8) }));
      leaves = Array.from({ length: mobile() ? 3 : 5 }, () => newLeaf(rnd(-W * 0.2, W)));
      trails = [];
    };
    const leafCols = ['#8a8a3c', '#a99a4a', '#6f7a34', '#c2a35a'];
    function newLeaf(x = -30): Leaf {
      return { x, y: rnd(H * 0.05, H * 0.75), d: rnd(0.6, 1.2), rot: rnd(0, 6.3), spin: rnd(-3, 3), ph: rnd(0, 6.3), c: leafCols[(Math.random() * leafCols.length) | 0] };
    }

    let last = 0, raf = 0, running = false;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - (last || now)) / 1000);
      last = now; t += dt;
      const w = wind();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);

      // wind trails: faint curved strokes that sweep across in gusts
      if (trails.length < (w > 1.6 ? 3 : 1) && Math.random() < dt * (w > 1.6 ? 1.6 : 0.4)) {
        trails.push({ x: rnd(-W * 0.3, W * 0.4), y: rnd(H * 0.12, H * 0.85), len: rnd(W * 0.12, W * 0.26), amp: rnd(4, 12), life: 0, ttl: rnd(1.4, 2.4), sp: rnd(W * 0.25, W * 0.45) });
      }
      ctx.lineCap = 'round';
      trails = trails.filter((tr) => {
        tr.life += dt; tr.x += tr.sp * dt * (0.6 + w * 0.4);
        const k = tr.life / tr.ttl; if (k >= 1) return false;
        const alpha = Math.sin(Math.PI * k) * 0.32;
        const g = ctx.createLinearGradient(tr.x, 0, tr.x + tr.len, 0);
        g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.6, `rgba(255,255,255,${alpha})`); g.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.strokeStyle = g; ctx.lineWidth = 1.1;
        ctx.beginPath();
        for (let i = 0; i <= 24; i++) {
          const px = tr.x + (tr.len * i) / 24;
          const py = tr.y + Math.sin(i / 24 * Math.PI * 1.6 + tr.life * 2) * tr.amp;
          i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
        ctx.stroke();
        return true;
      });

      // pollen drifting on the breeze
      for (const m of motes) {
        m.x += (14 + 26 * w) * m.d * dt;
        m.y += Math.sin(t * 1.3 + m.ph) * 9 * dt - 3 * dt;
        if (m.x > W + 10) { m.x = -10; m.y = rnd(H * 0.2, H); }
        if (m.y < H * 0.1) m.y = H;
        ctx.fillStyle = `rgba(255,248,230,${m.a})`;
        ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, 6.283); ctx.fill();
      }

      // a few leaves tumbling across
      for (let i = 0; i < leaves.length; i++) {
        const l = leaves[i];
        l.x += (30 + 60 * w) * l.d * dt;
        l.y += (Math.sin(t * 1.7 + l.ph) * 28 + 10) * dt;
        l.rot += l.spin * dt * (0.5 + w * 0.5);
        if (l.x > W + 40 || l.y > H + 30) leaves[i] = newLeaf();
        const sz = (mobile() ? 5 : 7) * l.d;
        ctx.save(); ctx.translate(l.x, l.y); ctx.rotate(l.rot); ctx.scale(1, Math.abs(Math.cos(t * 2.2 + l.ph)) * 0.8 + 0.2);
        ctx.fillStyle = l.c; ctx.globalAlpha = 0.85;
        ctx.beginPath(); ctx.ellipse(0, 0, sz, sz * 0.45, 0, 0, 6.283); ctx.fill();
        ctx.restore();
      }

      // butterflies
      const base = Math.max(17, IW * s * 0.016);
      for (const f of flies) {
        if (f.el.style.display === 'none') continue;
        if (f.rest > 0) {
          f.rest -= dt; f.vx *= 0.8; f.vy *= 0.8;
          f.x += w > 2 ? (w - 2) * 6 * dt : 0; // a strong gust nudges it
          if (f.rest <= 0) { pick(f); f.el.style.setProperty('--flap', `${rnd(0.14, 0.2).toFixed(2)}s`); }
        } else {
          const dx = f.tx - f.x, dy = f.ty - f.y, dist = Math.hypot(dx, dy);
          const sp = base * 7;
          // steer toward target, with fluttery wobble and the breeze pushing sideways
          f.vx += ((dx / (dist || 1)) * sp - f.vx) * dt * 1.6 + Math.sin(t * 7 + f.seed) * base * 14 * dt + (w - 1) * base * 2.2 * dt;
          f.vy += ((dy / (dist || 1)) * sp - f.vy) * dt * 1.6 + Math.cos(t * 9 + f.seed * 1.7) * base * 18 * dt;
          if (dist < base * 1.5) {
            if (Math.random() < 0.35) { f.rest = rnd(1.2, 3); f.el.style.setProperty('--flap', '.9s'); } else pick(f);
          }
        }
        f.x += f.vx * dt; f.y += f.vy * dt;
        if (f.x < -40 || f.x > W + 40 || f.y > H + 40 || f.y < 0) { pick(f); }
        if (Math.abs(f.vx) > 4) f.face = f.vx > 0 ? 1 : -1;
        // nearer the camera (lower on screen) = a little bigger
        const depth = 0.75 + 0.6 * Math.max(0, Math.min(1, f.y / H - 0.45) / 0.55);
        const tilt = Math.max(-25, Math.min(25, f.vy * 0.25));
        const sc = (base / 24) * depth;
        f.el.style.transform = `translate3d(${f.x - 12}px,${f.y - 11}px,0) scale(${sc * f.face},${sc}) rotate(${tilt * f.face}deg)`;
        f.el.style.opacity = '1';
      }
      raf = requestAnimationFrame(frame);
    };

    const start = () => { if (!running) { running = true; last = 0; raf = requestAnimationFrame(frame); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };
    const setup = () => { fit(); placeFlies(); seedAir(); };
    setup();
    let rt = 0;
    new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(setup, 120); }).observe(stage);
    let inView = false;
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; inView && !document.hidden ? start() : stop(); }).observe(stage);
    document.addEventListener('visibilitychange', () => (document.hidden || !inView ? stop() : start()));
  }
</script>
